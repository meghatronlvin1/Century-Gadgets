# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL Connection Variables (injected at runtime by AI Studio)
SQL_HOST="MY_SQL_HOST"
SQL_DB_NAME="MY_SQL_DB_NAME"
SQL_USER="MY_SQL_USER"
SQL_PASSWORD="MY_SQL_PASSWORD"
SQL_ADMIN_USER="MY_SQL_ADMIN_USER"
SQL_ADMIN_PASSWORD="MY_SQL_ADMIN_PASSWORD"

# Application Auth & Payment Webhook Security (set in production secrets)
APP_TOKEN_SECRET="CHANGE_ME_IN_PRODUCTION"
PAYMENT_WEBHOOK_SECRET="CHANGE_ME_IN_PRODUCTION"
PAYMENT_PROVIDER_MODE="sandbox"

# Century Gadgets Store & Social Configuration
CENTURY_STORE_PHONE="+256700000000"
CENTURY_WHATSAPP_NUMBER="+256700000000"
CENTURY_STORE_ADDRESS="Kampala Road, Mabirizi Complex Level 2, Shop L2-14, Kampala, Uganda"
CENTURY_STORE_HOURS="Mon–Sat: 9:00 AM – 7:30 PM | Sun: 11:00 AM – 5:00 PM"
CENTURY_TIKTOK_URL="https://www.tiktok.com/@centurygadgets"
